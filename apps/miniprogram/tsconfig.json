{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "module": "CommonJS",
    "target": "ES2018",
    "moduleResolution": "Node",
    "experimentalDecorators": true,
    "removeComments": true,
    "lib": ["ES2018"],
    "typeRoots": ["./node_modules/@types", "./node_modules"],
    "types": []
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "./**/*.test.ts", "./tests/**", "./vitest.config.ts"]
}
