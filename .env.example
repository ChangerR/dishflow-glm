# DishFlow 环境变量示例。复制为 .env 后按需修改（.env 已被 gitignore）。

# HTTP 监听
SHOP_SERVE_ADDR=127.0.0.1:8080

# MySQL 8 DSN（parseTime 必开；loc=UTC 统一存 UTC）
SHOP_DATABASE_DSN=shop:shop@tcp(127.0.0.1:3306)/dishflow?parseTime=true&loc=UTC&charset=utf8mb4

# Redis（十分钟报价 / 部分会话 / Worker 心跳）。可丢弃基础设施。
SHOP_REDIS_ADDR=redis://127.0.0.1:6379/0

# 会话与报价签名密钥（生产必须足够长；过短 fail closed）
SHOP_SESSION_SIGNING_KEY=change-me-to-a-long-random-string-min-32-chars
SHOP_QUOTE_SIGNING_KEY=change-me-to-another-long-random-string-min-32-chars

# 凭证加密 key（AES-GCM），用于 AppSecret/商户私钥/APIv3/打印 KEY 等。生产非空。
SHOP_CREDENTIAL_KEY=

# 可信代理 CIDR 列表（逗号分隔）。只有来自这些 IP 时才信任 X-Forwarded-For。
SHOP_TRUSTED_PROXIES=

# 开发模式：开启后服务端始终可使用 mock 支付/打印（后台需醒目警告）
SHOP_DEV_MODE=false

# 日志级别 debug|info|warn|error
SHOP_LOG_LEVEL=info
