.detail { padding: 12px; }
.card { background: #fff; border-radius: 8px; padding: 12px; margin-bottom: 10px; }
.state-card { text-align: center; }
.no { font-size: 28px; font-weight: 700; color: #1677ff; display: block; }
.sched { font-size: 13px; color: #d48806; }
.item { display: flex; justify-content: space-between; padding: 6px 0; font-size: 14px; }
.total { border-top: 1px solid #eee; margin-top: 8px; padding-top: 8px; text-align: right; color: #ff4d4f; font-weight: 600; }
.title { font-weight: 600; margin-bottom: 8px; }
.event { padding: 6px 0; border-bottom: 1px solid #f5f5f5; }
.summary { font-size: 13px; }
.time { font-size: 11px; color: #999; display: block; }
